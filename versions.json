{
  "release": "0.17.0",
  "modules": {
    "app": {
      "version": "0.3.2",
      "description": "The map app: bundled index.html and its editable source",
      "paths": [
        "index.html",
        "source/**"
      ],
      "markers": []
    },
    "api-tts": {
      "version": "0.2.1",
      "description": "Voice endpoint /api/tts and its helpers",
      "paths": [
        "api/tts.js",
        "lib/**"
      ],
      "markers": [
        {
          "file": "api/tts.js",
          "text": "// api-tts v{v}"
        },
        {
          "file": "lib/tts-core.mjs",
          "text": "// api-tts v{v}"
        }
      ]
    },
    "enhancements": {
      "version": "0.2.0",
      "description": "Wake lock, accessibility labels and reduced motion (assets/arah-enhancements.js)",
      "paths": [
        "assets/arah-enhancements.js"
      ],
      "markers": [
        {
          "file": "assets/arah-enhancements.js",
          "text": "/*! ARAH enhancements v{v}"
        },
        {
          "file": "assets/arah-enhancements.js",
          "text": "window.__arahEnh = '{v}';"
        }
      ]
    },
    "ar-vision": {
      "version": "0.3.1",
      "description": "AR driver assist: camera + WebGL YOLOX hazards, distance, speed and lane (assets/ar/)",
      "paths": [
        "assets/ar/**"
      ],
      "markers": [
        {
          "file": "assets/ar/arah-ar.js",
          "text": "/*! ARAH AR driver assist v{v}"
        },
        {
          "file": "assets/ar/arah-ar.js",
          "text": "window.__arahAR = '{v}';"
        },
        {
          "file": "assets/ar/ar-core.mjs",
          "text": "// ar-vision v{v}"
        },
        {
          "file": "assets/ar/ar-engine.mjs",
          "text": "// ar-vision v{v}"
        },
        {
          "file": "assets/ar/ar-worker.js",
          "text": "// ar-vision v{v}"
        }
      ]
    },
    "security-headers": {
      "version": "0.7.0",
      "description": "HTTP security headers and the security policy document",
      "paths": [
        "vercel.json",
        "SECURITY.md"
      ],
      "markers": []
    },
    "privacy": {
      "version": "0.7.0",
      "description": "Privacy notice page (/privacy)",
      "paths": [
        "privacy.html"
      ],
      "markers": [
        {
          "file": "privacy.html",
          "text": "<meta name=\"module-version\" content=\"privacy {v}\">"
        }
      ]
    },
    "ci": {
      "version": "0.15.0",
      "description": "Tests, guard rails and GitHub Actions",
      "paths": [
        ".github/**",
        "scripts/**",
        "test/**"
      ],
      "markers": []
    },
    "docs": {
      "version": "0.11.0",
      "description": "README and its animated art",
      "paths": [
        "README.md",
        "VERSIONING.md",
        "assets/arah-banner.svg",
        "assets/arah-features.svg",
        "assets/arah-divider.svg",
        "assets/arah-logo*.png",
        "assets/rydetech-logo.png"
      ],
      "markers": []
    },
    "pwa": {
      "version": "0.1.16",
      "description": "Installable app: manifest, service worker, offline page, icons, install and update UI",
      "paths": [
        "sw.js",
        "sw-precache.js",
        "manifest.webmanifest",
        "offline.html",
        "assets/arah-pwa.js",
        "assets/icons/**",
        "assets/splash/**"
      ],
      "markers": [
        {
          "file": "sw.js",
          "text": "// ARAH service worker  pwa v{v}"
        },
        {
          "file": "assets/arah-pwa.js",
          "text": "/*! ARAH PWA v{v}"
        },
        {
          "file": "assets/arah-pwa.js",
          "text": "window.__arahPWA = '{v}';"
        },
        {
          "file": "offline.html",
          "text": "<meta name=\"module-version\" content=\"pwa {v}\">"
        }
      ]
    },
    "places": {
      "version": "0.2.0",
      "description": "Makan & Mall: Malaysian fast-food and mall directory with logos, live OpenStreetMap outlets (assets/places/)",
      "paths": [
        "assets/places/**"
      ],
      "markers": [
        {
          "file": "assets/places/arah-places.js",
          "text": "/*! ARAH Makan & Mall v{v}"
        },
        {
          "file": "assets/places/arah-places.js",
          "text": "window.__arahPlaces = '{v}';"
        },
        {
          "file": "assets/places/places-core.mjs",
          "text": "// places v{v}"
        },
        {
          "file": "assets/places/brands.mjs",
          "text": "// places v{v}"
        }
      ]
    },
    "festive": {
      "version": "0.2.1",
      "description": "Festival themes for Malaysia: glowing UI, lit route, lanterns, bunting, tap fireworks (assets/festive/)",
      "paths": [
        "assets/festive/**"
      ],
      "markers": [
        {
          "file": "assets/festive/arah-festive.js",
          "text": "/*! ARAH festive theme v{v}"
        },
        {
          "file": "assets/festive/arah-festive.js",
          "text": "window.__arahFestive = '{v}';"
        },
        {
          "file": "assets/festive/festivals.mjs",
          "text": "// festive v{v}"
        },
        {
          "file": "assets/festive/fx.mjs",
          "text": "// festive v{v}"
        }
      ]
    },
    "keepawake": {
      "version": "0.3.0",
      "description": "Keep the screen awake while ARAH is open (assets/keepawake/)",
      "paths": [
        "assets/keepawake/**"
      ],
      "markers": [
        {
          "file": "assets/keepawake/arah-keepawake.js",
          "text": "/*! ARAH keep-awake v{v}"
        },
        {
          "file": "assets/keepawake/arah-keepawake.js",
          "text": "window.__arahKeepAwake = '{v}';"
        }
      ]
    },
    "resilience": {
      "version": "0.1.0",
      "description": "Timeouts and failover for Overpass, Photon and OSRM (assets/resilience/)",
      "paths": [
        "assets/resilience/**"
      ],
      "markers": [
        {
          "file": "assets/resilience/arah-resilience.js",
          "text": "/*! ARAH Network Resilience v{v}"
        },
        {
          "file": "assets/resilience/arah-resilience.js",
          "text": "var VERSION = '{v}';"
        }
      ]
    },
    "observability": {
      "version": "0.1.2",
      "description": "Opt-in Sentry crash reports with on-device scrubbing (assets/observability/)",
      "paths": [
        "assets/observability/arah-observe.js",
        "assets/observability/scrub.mjs",
        "assets/observability/sentry-entry.mjs",
        "assets/observability/config.json",
        "assets/observability/vendor/**",
        "scripts/observability/**"
      ],
      "markers": [
        {
          "file": "assets/observability/arah-observe.js",
          "text": "/*! ARAH Crash Reports v{v}"
        },
        {
          "file": "assets/observability/arah-observe.js",
          "text": "var VERSION = '{v}';"
        }
      ]
    },
    "vehicles": {
      "version": "0.1.0",
      "description": "3D vehicle marker while navigating, interactive (assets/vehicles/)",
      "paths": [
        "assets/vehicles/**"
      ],
      "markers": [
        {
          "file": "assets/vehicles/arah-vehicles.js",
          "text": "/*! ARAH vehicles v{v}"
        },
        {
          "file": "assets/vehicles/arah-vehicles.js",
          "text": "window.__arahVehicles = '{v}';"
        },
        {
          "file": "assets/vehicles/vehicles-3d.mjs",
          "text": "// ARAH vehicles v{v}"
        }
      ]
    },
    "a11y": {
      "version": "0.1.0",
      "description": "Landmarks, AAA contrast, 44 px targets, no overlap with the bottom panel (assets/a11y/)",
      "paths": [
        "assets/a11y/**"
      ],
      "markers": [
        {
          "file": "assets/a11y/arah-a11y.js",
          "text": "/*! ARAH a11y v{v}"
        },
        {
          "file": "assets/a11y/arah-a11y.js",
          "text": "window.__arahA11y = '{v}';"
        }
      ]
    },
    "twa": {
      "version": "0.1.0",
      "description": "Android (Trusted Web Activity) packaging, Play listing drafts, asset links (twa/, .well-known/)",
      "paths": [
        "twa/**",
        "scripts/twa/**",
        ".well-known/**",
        ".github/workflows/android.yml"
      ],
      "markers": []
    }
  }
}
